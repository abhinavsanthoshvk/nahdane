<script>
const WA_BASE = "https://wa.me/OWNER_WHATSAPP_NUMBER?text=";
const GREETING = "Hello NAHDA – GOLD & DIAMONDS, I would like to know more about your jewellery collection. Please share the details.";
document.querySelectorAll("[data-wa]").forEach(el => {
  const extra = el.getAttribute("data-wa");
  const msg = extra ? "Hello NAHDA – GOLD & DIAMONDS. " + extra + " Please share the details." : GREETING;
  el.setAttribute("href", WA_BASE + encodeURIComponent(msg));
  el.setAttribute("target", "_blank");
  el.setAttribute("rel", "noopener");
});

const burger = document.getElementById("burger"), menu = document.getElementById("menu");
function setMenu(open){
  menu.classList.toggle("open", open);
  burger.setAttribute("aria-expanded", String(open));
  burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
}
burger.addEventListener("click", () => setMenu(!menu.classList.contains("open")));

const io = new IntersectionObserver(es => es.forEach(en => {
  if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); }
}), { threshold: .12 });
function observeReveals(root){
  root.querySelectorAll(".reveal:not(.in)").forEach(el => io.observe(el));
}

const FILTERS = ["gold", "diamond", "bridal", "everyday"];
function applyFilter(f){
  const v = FILTERS.includes(f) ? f : "all";
  document.querySelectorAll(".product[data-cat]").forEach(p => {
    p.hidden = !(v === "all" || p.dataset.cat === v);
  });
  document.querySelectorAll(".filters a[data-f]").forEach(a => {
    a.classList.toggle("active", a.dataset.f === v);
  });
}

const PAGE_NAMES = ["home", "about", "products", "contact"];
function showPage(name, filter){
  if (!PAGE_NAMES.includes(name)) name = "home";
  document.querySelectorAll(".page").forEach(p => p.classList.toggle("active", p.dataset.page === name));
  document.querySelectorAll("[data-nav]").forEach(a => {
    if (a.dataset.nav === name) a.setAttribute("aria-current", "page");
    else a.removeAttribute("aria-current");
  });
  if (name === "products") applyFilter(filter);
  setMenu(false);
  const active = document.querySelector(".page.active");
  observeReveals(active);
  window.scrollTo(0, 0);
}

// Intercept in-site links (no URL/history changes, so it works in sandboxed previews too)
document.addEventListener("click", e => {
  const a = e.target.closest('a[href^="#"]');
  if (!a) return;
  const name = a.getAttribute("href").slice(1);
  if (!PAGE_NAMES.includes(name)) return;
  e.preventDefault();
  showPage(name, a.dataset.f);
});

const form = document.getElementById("enq-form");
if (form) form.addEventListener("submit", e => {
  e.preventDefault();
  if (form.website.value) return;
  document.getElementById("confirm").style.display = "block";
  form.reset();
});

showPage("home");
</script>
